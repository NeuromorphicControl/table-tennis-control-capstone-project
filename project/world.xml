<mujoco>
  <compiler meshdir="assets" texturedir="assets"/>
  <statistic extent="1.5" meansize=".05"/>

  <default>
  <!-- <geom solref="0.01 0.025"/> -->
  <pair solref="0.01 0.025"/> 
  </default>

  <option timestep="1e-5" jacobian="auto" cone="elliptic" integrator="implicitfast" gravity="0 0 -9.81"/>

  <visual>
    <rgba haze="0.15 0.25 0.35 1"/>
    <quality shadowsize="4096"/>
    <map stiffness="700" shadowscale="0.5" fogstart="10" fogend="15" zfar="40" haze="0.3"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
    <texture name="texplane" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 0.15 0.2"
      width="512" height="512" mark="cross" markrgb=".8 .8 .8"/>

    <mesh file="table.obj"/>

    <mesh file="arm-base.obj"/>
    <mesh file="rotator.obj"/>
    <mesh file="arm1.obj"/>
    <mesh file="arm2.obj"/>
    <mesh file="paddle-rotator.obj"/>
    <mesh file="paddle.obj"/>

    <material name="matplane" reflectance="0.3" texture="texplane" texrepeat="1 1" texuniform="true"/>
  </asset>

  <worldbody>
    <!-- Lights -->
    <!-- <light directional="true" diffuse=".4 .4 .4" specular="0.1 0.1 0.1" pos="0 0 5.0" dir="0 0 -1" castshadow="false"/> -->
    <light directional="true" diffuse=".6 .6 .6" specular="0.2 0.2 0.2" pos="0 0 4" dir="0 0 -1"/>

    <!-- Cameras -->
    <camera name="top_down" pos="0 0 10" euler="0 0 90"/>

    <!-- Ground -->
    <geom name="ground" type="plane" size="0 0 1" pos="0 0 0" quat="1 0 0 0" material="matplane" condim="1"/>

    <!-- Table -->
    <body name="table" pos="0 0 0" euler="0 0 0">
      <geom type="mesh" mesh="table" pos="0 0 0.01" euler="0 0 0" contype="0" conaffinity="0"/>

      <!-- Add geoms for collision detection -->
      <geom name="table_collider_v" type="box" size="0.9225 0.0025 0.07625" pos="0 0 0.83625" rgba="0 0 0 0"/>
      <geom name="table_collider_h" type="box" size="0.7625 1.37 0.025" pos="0 0 0.735" rgba="0 0 0 0"/>
    </body>

    <!-- Arm Base -->
    <body name="base" pos="0 -3.255 0.45" euler="0 0 0">
      <joint type="slide" axis="0 1 0" name="base_x" range="-1.8 1.8" damping="2"/>
      <joint type="slide" axis="1 0 0" name="base_y" range="-1.8 1.8" damping="2"/>
      <geom type="mesh" mesh="arm-base" pos="0 0.95 0.42" euler="0 0 180" rgba=".15 .15 .15 1" mass="12.5" contype="0" conaffinity="0"/>

      <!-- Camera -->
      <camera name="follow" pos="0 -2.5 1.5" euler="80 0 0" mode="track"/>

      <!-- Rotator 1 -->
      <body name="rotator1" pos="0 0.5 0.425" euler="0 0 0">
        <joint type="hinge" axis="0 0 1" name="rotator1" damping="0.04"/>
        <geom type="mesh" mesh="rotator" pos="0 0.45 0" euler="0 0 180" rgba=".15 .15 .15 1" mass="0.250" contype="0" conaffinity="0"/>

        <!-- Rotator 2 -->
        <body name="rotator2" pos="0 0.055 0.06" euler="-90 0 90">
          <joint type="hinge" axis="0 0 1" name="rotator2" damping="0.04"/>
          <geom type="mesh" mesh="rotator" pos="0 -0.45 0" euler="0 0 0" rgba=".15 .15 .15 1" mass="0.250" contype="0" conaffinity="0"/>

          <!-- Arm 1 -->
          <body name="arm1" pos="0 -0.050 0.061" euler="90 0 45">
            <joint type="hinge" axis="0 0 1" name="arm1" damping="0.04"/>
            <geom type="mesh" mesh="arm1" pos="0 0.335 -0.11" euler="0 0 180" rgba=".15 .15 .15 1" mass="0.550" contype="0" conaffinity="0"/>

            <!-- Arm 2 -->
            <body name="arm2" pos="0 0.5 0.045" euler="0 0 -90">
              <joint type="hinge" axis="0 0 1" name="arm2" damping="0.04"/>
              <geom type="mesh" mesh="arm2" pos="0 -0.164 -0.155" euler="0 0 180" rgba=".15 .15 .15 1" mass="0.450" contype="0" conaffinity="0"/>

              <!-- Paddle Rotator -->
              <body name="paddle_rotator" pos="0 0.4 0.015" euler="0 180 -45">
                <joint type="hinge" axis="0 0 1" name="paddle_rotator" damping="0.01"/>
                <geom type="mesh" mesh="paddle-rotator" pos="0 -0.565 0.174" euler="0 0 0" rgba=".15 .15 .15 1" mass="0.1" contype="0" conaffinity="0"/>

                <!-- Paddle -->
                <body name="paddle" pos="0 0.065 0.035" euler="-90 0 -90">
                  <joint type="hinge" axis="0 0 1" name="paddle" damping="0.01"/>
                  <geom type="mesh" mesh="paddle" pos="-0.094 0 0" euler="90 0 0" rgba="1 .4 .4 1" mass="0.150"/>
                  <site name="paddle_site" pos="0 0 0.1855" euler="0 180 0" size="0.015" rgba="1 0 0 1"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>


  <actuator>
    <motor name="base_x" joint="base_x"/>
    <motor name="base_y" joint="base_y"/>
    <motor name="rotator1" joint="rotator1"/>
    <motor name="rotator2" joint="rotator2"/>
    <motor name="arm1" joint="arm1"/>
    <motor name="arm2" joint="arm2"/>
    <motor name="paddle_rotator" joint="paddle_rotator"/>
    <motor name="paddle" joint="paddle"/>
  </actuator>
</mujoco>